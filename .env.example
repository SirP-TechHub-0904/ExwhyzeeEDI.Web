# Application Port & Hosting Environment
PORT=5005
ASPNETCORE_URLS=http://0.0.0.0:5005
ASPNETCORE_ENVIRONMENT=Production

# Database Connection (DefaultConnection)
ConnectionStrings__DefaultConnection=Server=[REDACTED_SERVER_IP],1433;Initial Catalog=DB_9AFABF_EDIPROGRAM;User Id=user_db;Password=your_database_password_here;TrustServerCertificate=True;MultipleActiveResultSets=true
DEFAULT_CONNECTION=Server=[REDACTED_SERVER_IP],1433;Initial Catalog=DB_9AFABF_EDIPROGRAM;User Id=user_db;Password=your_database_password_here;TrustServerCertificate=True;MultipleActiveResultSets=true

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# Flutterwave Payment / BVN Verification
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key_here

# Kudi SMS Credentials
SMS_USERNAME=your_sms_username_here
SMS_PASSWORD=your_sms_password_here
SMS_SENDER=EDI

# SMTP Mail Server Credentials
SMTP_HOST=mail.edi.exwhyzee.ng
SMTP_PORT=587
SMTP_USER=noreply@edi.exwhyzee.ng
SMTP_PASS=your_smtp_password_here
SMTP_FROM=noreply@edi.exwhyzee.ng

# Admin Notifications
ADMIN_NOTIFICATION_EMAILS=admin@exwhyzee.ng

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=yffz4ii9
CLOUDINARY_API_KEY=[REDACTED_SECRET_KEY]
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
CLOUDINARY_ROOT_FOLDER=edi
