@model IEnumerable<ExwhyzeeEDI.Web.Models.Entities.Post>

@using System.Text.RegularExpressions;
@functions {
    public string Truncate(string input, int length)
    {
        try
        {
            if (string.IsNullOrEmpty(input)) return "";
            if (input.Length <= length) return input;
            int idx = input.IndexOf(" ", length);
            if (idx > 0) return input.Substring(0, idx);
            return input.Substring(0, Math.Min(length, input.Length));
        }
        catch { return input ?? ""; }
    }
}


@foreach (var item in Model)
{

    
    @*<a href="@Url.Action(" Details", "Blog" , new { id=item.Id })" class="btn-read-more">Read more</a>*@


<div class="col-lg-4 col-md-4 col-sm-4 col-xs-12 single-blog-post">
    <div class="img-holder hvr-rectangle-out">
        @if (!String.IsNullOrEmpty(item.ImageUrl))
        {
            <img src="@ExwhyzeeEDI.Web.Models.HelperClass.ResolveImageUrl(item.ImageUrl, "Uploads")" alt="" class="">

        }
        <div class="date">
            <b>@item.DatePosted.ToString("dd")</b> <br> @item.DatePosted.ToString("MMM")
        </div>
    </div>
    <a href="#"><h2>@item.PostTite</h2></a>
    <p>  @Truncate(item.PostContentPreview, 170)</p>
    <ul>
        <li><span><b>By: </b> E.D.I</span></li>
        <li><a href="#">Better Nigeria</a></li>
    </ul>
</div>

}