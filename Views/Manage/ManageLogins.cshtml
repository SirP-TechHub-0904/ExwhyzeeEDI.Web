@model ExwhyzeeEDI.Web.Models.ManageLoginsViewModel
@using Microsoft.AspNetCore.Authentication
@{
    ViewBag.Title = "Manage your external logins";
}

<h2>@ViewBag.Title.</h2>

<p class="text-success">@ViewBag.StatusMessage</p>
@{
    var loginProviders = Model.OtherLogins;
    if (loginProviders.Count == 0 && Model.CurrentLogins.Count == 0) {
        <div>
            <p>
                There are no external authentication services configured.
            </p>
        </div>
    }
    else
    {
        if (Model.CurrentLogins.Count > 0)
        {
            <h4>Registered Logins</h4>
            <table class="table">
                <tbody>
                    @foreach (var account in Model.CurrentLogins)
                    {
                        <tr>
                            <td>@account.LoginProvider</td>
                            <td>
                                @if (ViewBag.ShowRemoveButton == true)
                                {
                                    <form asp-action="RemoveLogin" asp-controller="Manage" method="post">
                                        @Html.AntiForgeryToken()
                                        <div>
                                            <input type="hidden" name="loginProvider" value="@account.LoginProvider" />
                                            <input type="hidden" name="providerKey" value="@account.ProviderKey" />
                                            <input type="submit" class="btn btn-default" value="Remove" title="Remove this @account.LoginProvider login from your account" />
                                        </div>
                                    </form>
                                }
                                else
                                {
                                    @: &nbsp;
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        if (Model.OtherLogins.Count > 0)
        {
            <form asp-action="LinkLogin" asp-controller="Manage" method="post">
                @Html.AntiForgeryToken()
                <div id="socialLoginList">
                <p>
                    @foreach (AuthenticationScheme p in Model.OtherLogins)
                    {
                        <button type="submit" class="btn btn-default" id="@p.Name" name="provider" value="@p.Name" title="Log in using your @p.DisplayName account">@p.DisplayName</button>
                    }
                </p>
                </div>
            </form>
        }
    }
}
